// Prisma schema — fonte declarativa pra `prisma db push` / `prisma migrate`.
//
// Multi-tenant: todo agregado raiz (Caixinha, Cartao, Categoria, Espaco,
// AppSettings, Contato) tem dono (`userId` → users.id, coluna user_id). O que
// pende de um raiz (movimentações, despesas, shares…) herda o dono pela FK e é
// filtrado pela relação — nunca ganha user_id próprio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoMovimentacao {
  aporte
  despesa

  @@map("tipo_movimentacao")
}

// Ciclo de vida do contato na agenda: nasce "local" (so um nome), vira
// "convidado" quando o dono dispara o convite e "ativo" quando a pessoa aceita
// (o vinculo passa a ser mutuo - ver Contato.espelhoDeId).
enum ContatoStatus {
  local
  convidado
  ativo
  recusado

  @@map("contato_status")
}

enum ShareAdocaoModo {
  fixa
  mes
  ignorado

  @@map("share_adocao_modo")
}

enum CartaoShareTipo {
  linha
  valor

  @@map("cartao_share_tipo")
}

// ── Auth (RBAC → PBAC) ───────────────────────────────────────────────────────
// Usuário tem N roles; role é um conjunto de permissions granulares (strings
// "recurso:acao", com wildcard: "caixinha:*", "*"). A autorização efetiva é
// PBAC: middleware checa permission, nunca role. Billing futuro (SaaS) pluga
// em server/auth/entitlements.ts filtrando as permissions pelo plano — sem
// mudança de schema aqui (no máximo ganha models Plan/Subscription próprios).

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  nome      String
  senhaHash String   @map("senha_hash")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles       UserRole[]
  appSettings AppSettings?
  caixinhas   Caixinha[]
  cartoes     Cartao[]
  categorias  Categoria[]
  espacos     Espaco[]
  contatos    Contato[]    @relation("ContatosDoDono")
  contatoDe   Contato[]    @relation("ContatoVinculado")

  convites      CartaoShareConvite[]
  adocoes       ShareAdocao[]
  adiantamentos ShareAdiantamento[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  nome        String   @unique
  descricao   String?
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Pessoa com quem o dono (`ownerId`) compartilha fatura de cartão. Existe sem
// login; quando ela vira usuária do app, `userId` vincula (por email, lazy) e
// ela passa a ver "o que devo". Ver server/modules/cartao-share.
model Contato {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  nome         String
  email        String?
  userId       String?       @map("user_id") @db.Uuid
  status       ContatoStatus @default(local)
  convidadoEm  DateTime?     @map("convidado_em") @db.Timestamptz(6)
  respondidoEm DateTime?     @map("respondido_em") @db.Timestamptz(6)
  // contato reciproco criado na agenda de quem aceitou (vinculo mutuo)
  espelhoDeId  String?       @map("espelho_de_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     User                 @relation("ContatosDoDono", fields: [ownerId], references: [id], onDelete: Cascade)
  user      User?                @relation("ContatoVinculado", fields: [userId], references: [id], onDelete: SetNull)
  espelhoDe Contato?             @relation("ContatoEspelho", fields: [espelhoDeId], references: [id], onDelete: SetNull)
  espelhos  Contato[]            @relation("ContatoEspelho")
  convites  CartaoShareConvite[]
  shares    CartaoShare[]

  // a mesma pessoa entra uma vez por agenda (mas pode ser contato de vários donos)
  @@unique([ownerId, userId])
  @@index([ownerId])
  @@index([email])
  @@map("contatos")
}

// Atribui parte da fatura de um cartão a um contato. Não altera a fatura do dono —
// camada informativa "quem me deve". Dois modos:
//   linha: aponta uma DespesaFixa OU DespesaMes; percentual (100 = linha inteira) ou valor fixo.
//   valor: valor avulso na fatura; mesRef null = recorrente todo mês, YYYY-MM = pontual.
model CartaoShare {
  id            String          @id @default(uuid()) @db.Uuid
  cartaoId      String?         @map("cartao_id") @db.Uuid
  contatoId     String          @map("contato_id") @db.Uuid
  tipo          CartaoShareTipo
  descricao     String          @default("")
  despesaFixaId String?         @map("despesa_fixa_id") @db.Uuid
  despesaMesId  String?         @map("despesa_mes_id") @db.Uuid
  percentual    Decimal?        @db.Decimal(5, 2)
  valor         Decimal?        @db.Decimal(12, 2)
  mesRef        String?         @map("mes_ref") @db.Char(7)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  cartao      Cartao?      @relation(fields: [cartaoId], references: [id], onDelete: Cascade)
  contato     Contato      @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  despesaFixa DespesaFixa? @relation(fields: [despesaFixaId], references: [id], onDelete: Cascade)
  despesaMes  DespesaMes?  @relation(fields: [despesaMesId], references: [id], onDelete: Cascade)

  // o mesmo contato nao entra duas vezes na mesma linha (o rateio ficaria errado
  // sem ninguem perceber). NULL e distinto no Postgres, entao share tipo "valor"
  // segue livre pra repetir contato.
  @@unique([despesaFixaId, contatoId], map: "share_fixa_contato_key")
  @@unique([despesaMesId, contatoId], map: "share_mes_contato_key")
  @@index([cartaoId])
  @@index([contatoId])
  @@map("cartao_shares")
}

model Caixinha {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  nome         String
  tipo         String? // discriminador server-controlled: "emergencia" na reserva provisionada; null nas demais
  aporteMensal Decimal  @default(0) @map("aporte_mensal") @db.Decimal(12, 2)
  taxaJuros    Decimal  @default(0) @map("taxa_juros") @db.Decimal(6, 2)
  meta         Decimal? @db.Decimal(12, 2)
  saldo        Decimal  @default(0) @db.Decimal(12, 2)
  cor          String   @default("blue")
  acumulaSobra Boolean  @default(false) @map("acumula_sobra")
  ordem        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movimentacoes Movimentacao[]

  @@index([userId])
  @@map("caixinhas")
}

model Movimentacao {
  id         String           @id @default(uuid()) @db.Uuid
  caixinhaId String           @map("caixinha_id") @db.Uuid
  tipo       TipoMovimentacao
  valor      Decimal          @db.Decimal(12, 2)
  descricao  String           @default("")
  data       DateTime         @db.Date
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  caixinha Caixinha @relation(fields: [caixinhaId], references: [id], onDelete: Cascade)

  @@index([caixinhaId])
  @@index([data])
  @@map("movimentacoes")
}

model Cartao {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  nome          String
  bandeira      String?
  limite        Decimal  @default(0) @db.Decimal(12, 2)
  diaFechamento Int?     @map("dia_fechamento")
  diaVencimento Int      @default(1) @map("dia_vencimento")
  cor           String   @default("violet")
  ordem         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  despesasFixas DespesaFixa[]
  despesasMes   DespesaMes[]
  shares        CartaoShare[]

  @@index([userId])
  @@map("cartoes")
}

model Categoria {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  nome      String
  cor       String   @default("blue")
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  despesasFixas DespesaFixa[]
  despesasMes   DespesaMes[]

  @@index([userId])
  @@map("categorias")
}

model Espaco {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  nome        String
  tipo        String   @default("outro")
  emoji       String   @default("📁")
  rendaMensal Decimal  @default(0) @map("renda_mensal") @db.Decimal(12, 2)
  moeda       String   @default("BRL")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  despesasFixas   DespesaFixa[]
  despesasMes     DespesaMes[]
  receitasMes     ReceitaMes[]
  rendasMensais   RendaMensal[]
  appSettings     AppSettings[]
  pagamentosFixas PagamentoFixa[]
  mesesOcultos    EspacoMesOculto[]
  adocoes         ShareAdocao[]

  @@index([userId])
  @@map("espacos")
}

// Marca que um espaço está oculto num mês específico (exclusão só daquele mês,
// reversível). Dados do espaço seguem intactos nos outros meses.
model EspacoMesOculto {
  espacoId  String   @map("espaco_id") @db.Uuid
  ym        String   @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  espaco Espaco @relation(fields: [espacoId], references: [id], onDelete: Cascade)

  @@id([espacoId, ym])
  @@map("espaco_mes_oculto")
}

// Preferências por usuário (uma linha por user) — hoje só o espaço ativo.
model AppSettings {
  userId         String  @id @map("user_id") @db.Uuid
  activeEspacoId String? @map("active_espaco_id") @db.Uuid

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeEspaco Espaco? @relation(fields: [activeEspacoId], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

model DespesaFixa {
  id            String   @id @default(uuid()) @db.Uuid
  espacoId      String   @map("espaco_id") @db.Uuid
  descricao     String
  valor         Decimal  @db.Decimal(12, 2)
  diaVencimento Int      @default(1) @map("dia_vencimento")
  ativa         Boolean  @default(true)
  cartaoId      String?  @map("cartao_id") @db.Uuid
  parcelado     Boolean  @default(false)
  parcelaAtual  Int?     @map("parcela_atual")
  totalParcelas Int?     @map("total_parcelas")
  parcelaMesRef String?  @map("parcela_mes_ref") @db.Char(7)
  categoriaId   String?  @map("categoria_id") @db.Uuid
  nota          String?
  // true = o orcamento do dono conta so a parte dele (valor - soma dos shares).
  // false = share puramente informativo (comportamento historico).
  abateShares   Boolean  @default(false) @map("abate_shares")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  espaco     Espaco          @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  cartao     Cartao?         @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  categoria  Categoria?      @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  pagamentos PagamentoFixa[]
  shares     CartaoShare[]
  adocoes    ShareAdocao[]

  @@index([espacoId])
  @@index([cartaoId])
  @@index([categoriaId])
  @@map("despesas_fixas")
}

// Marca quanto de uma despesa fixa foi pago num mês específico (fixa recorre todo mês).
// valorPago acumula pagamentos parciais; quitada quando valorPago >= valor da fixa.
model PagamentoFixa {
  id            String   @id @default(uuid()) @db.Uuid
  espacoId      String   @map("espaco_id") @db.Uuid
  despesaFixaId String   @map("despesa_fixa_id") @db.Uuid
  ym            String   @db.Char(7)
  valorPago     Decimal  @default(0) @map("valor_pago") @db.Decimal(12, 2)
  pagoEm        DateTime @default(now()) @map("pago_em") @db.Timestamptz(6)

  espaco      Espaco      @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  despesaFixa DespesaFixa @relation(fields: [despesaFixaId], references: [id], onDelete: Cascade)

  @@unique([despesaFixaId, ym])
  @@index([espacoId, ym])
  @@map("pagamentos_fixas")
}

model DespesaMes {
  id          String   @id @default(uuid()) @db.Uuid
  espacoId    String   @map("espaco_id") @db.Uuid
  mes         String   @db.Char(7)
  descricao   String
  valor       Decimal  @db.Decimal(12, 2)
  data        DateTime @db.Date
  paga        Boolean  @default(false)
  valorPago   Decimal  @default(0) @map("valor_pago") @db.Decimal(12, 2)
  cartaoId    String?  @map("cartao_id") @db.Uuid
  categoriaId String?  @map("categoria_id") @db.Uuid
  nota        String?
  abateShares Boolean  @default(false) @map("abate_shares")
  // Id da transação no arquivo OFX importado — chave de dedup. Null repetido é
  // aceito pelo Postgres num unique composto, então lançamento manual segue livre.
  fitid       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  espaco    Espaco        @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  cartao    Cartao?       @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  categoria Categoria?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  shares    CartaoShare[]
  adocoes   ShareAdocao[]

  @@unique([espacoId, fitid], map: "despesa_mes_espaco_fitid_key")
  @@index([espacoId, mes])
  @@index([cartaoId])
  @@index([categoriaId])
  @@map("despesas_mes")
}

model ReceitaMes {
  id        String   @id @default(uuid()) @db.Uuid
  espacoId  String   @map("espaco_id") @db.Uuid
  // Para `recorrente`, `mes` é a ÂNCORA (primeiro mês em que vale) — a coluna
  // não foi renomeada de propósito: evita migration destrutiva e mantém a
  // receitaView compatível.
  mes       String   @db.Char(7)
  descricao String
  valor     Decimal  @db.Decimal(12, 2)
  data      DateTime @db.Date
  recorrente Boolean @default(false)
  mesFim    String?  @map("mes_fim") @db.Char(7) // último mês em que vale (null = sem fim)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  espaco Espaco           @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  skips  ReceitaMesSkip[]

  @@index([espacoId, mes])
  @@map("receitas_mes")
}

// Exceção pontual: receita recorrente pulada num mês específico. Sem user_id —
// herda o dono via receita → espaco → userId (padrão do repo pro que pende de
// agregado raiz).
model ReceitaMesSkip {
  receitaId String   @map("receita_id") @db.Uuid
  ym        String   @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receita ReceitaMes @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@id([receitaId, ym])
  @@map("receita_mes_skip")
}

model RendaMensal {
  id       String  @id @default(uuid()) @db.Uuid
  espacoId String  @map("espaco_id") @db.Uuid
  ym       String  @db.Char(7)
  valor    Decimal @default(0) @db.Decimal(12, 2)

  espaco Espaco @relation(fields: [espacoId], references: [id], onDelete: Cascade)

  @@unique([espacoId, ym])
  @@map("rendas_mensais")
}

// Convite de compartilhamento: o dono manda, a pessoa aceita ou recusa. Substitui
// o vinculo lazy silencioso (antes a pessoa via a divida sem ter consentido).
// Sem infra de email no projeto: o token vira link copiavel na UI.
model CartaoShareConvite {
  id        String        @id @default(uuid()) @db.Uuid
  ownerId   String        @map("owner_id") @db.Uuid
  contatoId String        @map("contato_id") @db.Uuid
  email     String
  token     String        @unique
  status    ContatoStatus @default(convidado)
  expiraEm  DateTime      @map("expira_em") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contato Contato @relation(fields: [contatoId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([contatoId])
  @@map("convites")
}

// Adocao: o devedor puxa o share pro proprio orcamento (fixa/mes) ou ignora.
// `shareId` e PK e NAO tem FK de proposito: se o dono apagar o share, a adocao
// sobrevive pra avisar "compartilhamento removido pelo dono" - a despesa criada
// e do devedor e nao pode sumir por decisao de terceiro.
// `valorAdotado` congela o valor no momento da adocao; divergencia vira aviso.
model ShareAdocao {
  shareId       String          @id @map("share_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  modo          ShareAdocaoModo
  espacoId      String?         @map("espaco_id") @db.Uuid
  despesaFixaId String?         @map("despesa_fixa_id") @db.Uuid
  despesaMesId  String?         @map("despesa_mes_id") @db.Uuid
  valorAdotado  Decimal?        @map("valor_adotado") @db.Decimal(12, 2)
  quitadoAte    String?         @map("quitado_ate") @db.Char(7) // adiantamento cobre ate este mes
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  espaco      Espaco?      @relation(fields: [espacoId], references: [id], onDelete: Cascade)
  despesaFixa DespesaFixa? @relation(fields: [despesaFixaId], references: [id], onDelete: SetNull)
  despesaMes  DespesaMes?  @relation(fields: [despesaMesId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("share_adocoes")
}

// Adiantamento de N parcelas de um share: move ShareAdocao.quitadoAte e zera o
// devido nos meses cobertos. Nao mexe na fatura do dono (share e informativo).
model ShareAdiantamento {
  id        String   @id @default(uuid()) @db.Uuid
  shareId   String   @map("share_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  valor     Decimal  @db.Decimal(12, 2)
  ym        String   @db.Char(7) // mes em que o adiantamento foi feito
  cobreAte  String   @map("cobre_ate") @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@index([userId])
  @@map("share_adiantamentos")
}
