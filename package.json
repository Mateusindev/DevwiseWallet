{
  "name": "cofre",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "bun run test:lib && bun run test:unit && bun run test:int && bun run test:front",
    "test:lib": "bun test ./lib/",
    "test:unit": "bun scripts/test-unit.ts",
    "test:int": "bun test tests/integration",
    "test:front": "bun test --preload ./tests/setup/dom.ts tests/front",
    "test:db:setup": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/cofre_test}\" DIRECT_URL=\"${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/cofre_test}\" prisma db push --skip-generate --accept-data-loss",
    "typecheck": "tsc --noEmit",
    "seed:auth": "bun scripts/seed-auth.ts",
    "seed:dev": "bun scripts/reseed.ts",
    "seed:test": "bun scripts/seed-test-account.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@prisma/client": "^6",
    "hono": "^4.12.28",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "happy-dom": "^20.11.1",
    "prisma": "^6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/client",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
