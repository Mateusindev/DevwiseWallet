# Copie para .env e ajuste. Nunca commite o .env (só este .env.example).

# ── Banco ────────────────────────────────────────────────────────────────────
# Postgres 16 do docker compose na raiz do repo Wallet/ (um nível acima).
# Porta 5434 de propósito: 5432/5433 já estão ocupadas por outro projeto.
DATABASE_URL="postgresql://cofre:cofre@localhost:5434/cofre"
# Conexão direta (sem pooler) usada pelo Prisma em migrate/db push.
DIRECT_URL="postgresql://cofre:cofre@localhost:5434/cofre"

# Em produção (Supabase), o runtime NÃO usa a porta 6543 (Supavisor em modo
# transaction). Ele multiplexa a mesma conexão de servidor entre clientes e o
# engine do Prisma chega a ler o resultado de OUTRA query com o row description
# errado — o sintoma é `PrismaClientUnknownRequestError` com
# `ConnectorError { kind: QueryError(FromSql(n) / Utf8Error) }` em findMany que
# nem tem linha (uuid binário decodificado como texto). Além disso o pooler
# custa ~713ms por ida ao banco contra ~141ms na 5432 (medido, ver CLAUDE.md).
# Então: runtime e Prisma CLI apontam para a porta 5432 (session mode).
#   DATABASE_URL="postgresql://...@aws-1-us-west-2.pooler.supabase.com:5432/postgres?connection_limit=1"
#   DIRECT_URL="postgresql://...@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Segredo do JWT HS256 do cookie httpOnly `auth_token`.
# Sem ele o dev sobe com fallback inseguro; produção recusa iniciar.
# Gerar: openssl rand -base64 48
AUTH_SECRET=""

# ── Leitura direta do Supabase (opcional) ────────────────────────────────────
# Com as TRÊS definidas, o navegador lê orçamento, cartões e o estado direto
# do PostgREST do Supabase (RLS só-leitura, só-dono). Sem elas, tudo segue
# pelas Server Actions — é assim no dev com Postgres local, nos testes e no CI.
# ANTES de ligar: aplicar prisma/manual/20261028-rls-leitura-direta.sql.
# Supabase → Project Settings → API (URL e anon/publishable key) e
# → JWT Keys (Legacy JWT secret; é ele que assina o token que o app emite).
# NEXT_PUBLIC_SUPABASE_URL="https://<projeto>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_JWT_SECRET=""   # SÓ servidor — nunca com prefixo NEXT_PUBLIC_

# ── Testes (opcional) ────────────────────────────────────────────────────────
# Banco usado por `bun run test:int` e `bun run test:db:setup`.
# O nome PRECISA conter "test": as suítes dão TRUNCATE em todas as tabelas.
# Default quando não definido: postgresql://postgres:postgres@localhost:5432/cofre_test
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cofre_test"

# ── Dev (opcional) ───────────────────────────────────────────────────────────
# Porta do `bun dev` / `bun start`. Default: 3000.
# PORT=3000
