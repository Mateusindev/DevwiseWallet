# Copie para .env e ajuste. Nunca commite o .env (só este .env.example).

# ── Banco ────────────────────────────────────────────────────────────────────
# Postgres 16 do docker compose na raiz do repo Wallet/ (um nível acima).
# Porta 5434 de propósito: 5432/5433 já estão ocupadas por outro projeto.
DATABASE_URL="postgresql://cofre:cofre@localhost:5434/cofre"
# Conexão direta (sem pooler) usada pelo Prisma em migrate/db push.
DIRECT_URL="postgresql://cofre:cofre@localhost:5434/cofre"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Segredo do JWT HS256 do cookie httpOnly `auth_token`.
# Sem ele o dev sobe com fallback inseguro; produção recusa iniciar.
# Gerar: openssl rand -base64 48
AUTH_SECRET=""

# ── Testes (opcional) ────────────────────────────────────────────────────────
# Banco usado por `bun run test:int` e `bun run test:db:setup`.
# O nome PRECISA conter "test": as suítes dão TRUNCATE em todas as tabelas.
# Default quando não definido: postgresql://postgres:postgres@localhost:5432/cofre_test
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cofre_test"

# ── Dev (opcional) ───────────────────────────────────────────────────────────
# Porta do `bun dev` / `bun start`. Default: 3000.
# PORT=3000
